# Copy to server/.env and adjust. Environment variables override these.
PORT=8955
# Bind address. 0.0.0.0 = reachable from the LAN (workshop mode),
# 127.0.0.1 = local only (e.g. behind nginx).
HOST=0.0.0.0
# Optional: public URL prefix when behind a reverse proxy that strips it (e.g. /web-gis).
# Only affects /docs and OpenAPI URLs. Leave empty when served at the root.
BASE_PATH=
